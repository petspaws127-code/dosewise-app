<?xml version="1.0" encoding="utf-8"?>
<!-- DoseWise adaptive-icon foreground: white two-tone capsule tilted -28°
     with center seam + white badge with teal check, on transparent.
     Scaled from the 64-grid logo SVG to the 108dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 64-grid art scaled ×1.125, centered (safe zone 72dp). -->
    <group
        android:translateX="18"
        android:translateY="18"
        android:scaleX="1.125"
        android:scaleY="1.125">
        <!-- Capsule tilted -28° about (32, 30). -->
        <group
            android:rotation="-28"
            android:pivotX="32"
            android:pivotY="30">
            <!-- White capsule body. -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M23.5,24 H40.5 A6.5,6.5 0 0 1 40.5,37 H23.5 A6.5,6.5 0 0 1 23.5,24 Z" />
            <!-- Two-tone left half (#CDE9DF). -->
            <path
                android:fillColor="#CDE9DF"
                android:pathData="M17,30.5 A6.5,6.5 0 0 1 23.5,24 H32 V37 H23.5 A6.5,6.5 0 0 1 17,30.5 Z" />
            <!-- Center seam. -->
            <path
                android:strokeColor="#0A5C51"
                android:strokeWidth="2"
                android:pathData="M32,24.5 L32,36.5" />
        </group>
        <!-- White badge circle. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M57.5,46 a10.5,10.5 0 1 1 -21,0 a10.5,10.5 0 1 1 21,0 Z" />
        <!-- Teal check. -->
        <path
            android:strokeColor="#0A5C51"
            android:strokeWidth="2.8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M42.3,46.2 l3.3,3.3 l5.9,-6.3" />
    </group>
</vector>
